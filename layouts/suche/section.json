{{- /* Suchindex /suche/index.json: alle Seiten mit Titel, Rubrik, Beschreibung und Klartext.
       Listen aus data/ (Bücher, KI-Tools, Links, Ideen, Fragen, Sprachen) werden als Text mit aufgenommen,
       damit auch Einträge ohne eigene Seite gefunden werden. Durchsucht wird im Browser (assets/js/suche.js). */ -}}
{{- $eintraege := slice }}
{{- range site.Pages }}
  {{- if and .Title (in (slice "page" "section" "term") .Kind) (ne .Section "suche") (ne .Section "filmjahrzehnte") }}
    {{- $p := . }}
    {{- $rubrik := "" }}
    {{- with .Parent }}{{ if not .IsHome }}{{ $rubrik = .Title }}{{ end }}{{ end }}
    {{- $text := .Plain }}
    {{- /* Listen aus data/: alle Textfelder der Einträge */}}
    {{- $liste := slice }}
    {{- with .Params.daten }}
      {{- if eq $p.Section "sprachen" }}{{ with index (index hugo.Data ($p.Params.datenbereich | default "sprachen")) . }}{{ $liste = .gruppe }}{{ end }}
      {{- else }}{{ with index hugo.Data . }}{{ $liste = index . ($p.Params.eintrag | default "buch") }}{{ end }}{{ end }}
    {{- end }}
    {{- /* Links: nur Seiten ohne Unterseiten nehmen ihre Einträge mit (kategorie, ggf. thema), Kachelseiten keine */}}
    {{- if and (in (slice "links" "kanaele") .Section) (eq .Kind "section") .Params.kategorie (not .Sections) }}
      {{- $liste = where hugo.Data.links.eintrag "kategorie" .Params.kategorie }}
      {{- with .Params.thema }}{{ $liste = where $liste "thema" . }}{{ end }}
    {{- end }}
    {{- if and (eq .Section "ideen") (eq .Kind "section") }}{{ $liste = hugo.Data.ideen.idee }}{{ end }}
    {{- if eq .RelPermalink "/fragen/" }}{{ $liste = hugo.Data.fragen.frage }}{{ end }}
    {{- /* IT-Übungen: Titel, Themen, Code und Erklärung jeder Aufgabe (data/uebungen/<blatt>.json) */}}
    {{- with .Params.uebungen }}{{ with index hugo.Data.uebungen . }}{{ $liste = .tasks }}{{ end }}{{ end }}
    {{- range $liste }}
      {{- range $k, $v := . }}
        {{- if eq (printf "%T" $v) "string" }}{{ $text = printf "%s %s" $text $v }}
        {{- else if reflect.IsSlice $v }}{{ range $v }}{{ if reflect.IsSlice . }}{{ $text = printf "%s %s" $text (delimit . " ") }}{{ else if eq (printf "%T" .) "string" }}{{ $text = printf "%s %s" $text . }}{{ end }}{{ end }}{{ end }}
      {{- end }}
    {{- end }}
    {{- /* Links aus dem Seitenkopf (youtube, imdb, wikipedia, sendung_youtube, webseite, [[hintergrund]] …), damit eine
           eingefügte Adresse ihre Seite findet (Sven, 2026-10-28): jedes Feld, das mit http beginnt, auch eine Ebene tiefer */}}
    {{- $links := slice }}
    {{- range $k, $v := .Params }}
      {{- if and (eq (printf "%T" $v) "string") (hasPrefix $v "http") }}{{ $links = $links | append $v }}
      {{- else if reflect.IsSlice $v }}{{ range $v }}{{ if reflect.IsMap . }}{{ range $k2, $v2 := . }}{{ if and (eq (printf "%T" $v2) "string") (hasPrefix $v2 "http") }}{{ $links = $links | append $v2 }}{{ end }}{{ end }}{{ end }}{{ end }}
      {{- end }}
    {{- end }}
    {{- $eintraege = $eintraege | append (dict
        "t" .Title
        "u" .RelPermalink
        "r" $rubrik
        "d" (.Description | default "")
        "m" (.Params.modell | default "")
        "k" (delimit (slice (.Params.autor | default "") (.Params.regie | default "") (.Params.originaltitel | default "") (delimit (.Params.darsteller | default slice) " ") (delimit $links " ")) " ")
        "x" ($text | htmlUnescape | replaceRE `\s+` " ")
      ) }}
  {{- end }}
{{- end }}
{{- $eintraege | jsonify }}
